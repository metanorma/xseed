<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    xmlns="http://example.com/simple"
    targetNamespace="http://example.com/simple"
    elementFormDefault="qualified">

  <xs:annotation>
    <xs:documentation>
      Simple test schema with three elements for HTML parity testing.
    </xs:documentation>
  </xs:annotation>

  <xs:element name="Person" type="PersonType">
    <xs:annotation>
      <xs:documentation>A person element.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:complexType name="PersonType">
    <xs:annotation>
      <xs:documentation>Person type with name and age.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="xs:string">
        <xs:annotation>
          <xs:documentation>Person's name.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="age" type="xs:int">
        <xs:annotation>
          <xs:documentation>Person's age in years.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="Company" type="xs:string">
    <xs:annotation>
      <xs:documentation>Company name element.</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="Employee" type="PersonType">
    <xs:annotation>
      <xs:documentation>Employee element using PersonType.</xs:documentation>
    </xs:annotation>
  </xs:element>

</xs:schema>