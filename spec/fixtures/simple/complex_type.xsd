<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:tns="http://example.com/complex"
           targetNamespace="http://example.com/complex"
           elementFormDefault="qualified">

  <xs:complexType name="PersonType">
    <xs:annotation>
      <xs:documentation>A person with name and age</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="name" type="xs:string"/>
      <xs:element name="age" type="xs:integer"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="ContactType">
    <xs:annotation>
      <xs:documentation>Contact information</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="email" type="xs:string"/>
      <xs:element name="phone" type="xs:string"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="person" type="tns:PersonType">
    <xs:annotation>
      <xs:documentation>Person element</xs:documentation>
    </xs:annotation>
  </xs:element>

  <xs:element name="contact" type="tns:ContactType">
    <xs:annotation>
      <xs:documentation>Contact element</xs:documentation>
    </xs:annotation>
  </xs:element>

</xs:schema>
